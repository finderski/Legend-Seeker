.npcTalents
    h3(class='headerLabel', data-i18n='talents') TALENTS
    fieldset(class="repeating_talents")
        .talent
            .chatButtons
                button(class="sendToChat", type="roll" name="roll_whisper_talent", value="/w gm @{character_name} has the Talent: @{talent_name}, which does @{talent_details}", data-i18n-title="whisper-to-chat")
                    span(name="attr_talent_name")
                .whisperButton 
                    button(class="whisperToChat", type="roll" name="roll_talent_to_chat", value="/em has the Talent: @{talent_name} (@{talent_page}), which does @{talent_details}", data-18n-title="send-to-chat")
                        span.iconButton q
            input(class="hidden", type="text", name="attr_talent_name", value="", data-i18n-placeholder="talent")
            input(class="hidden", type="text", name="attr_talent_page", value="")
            textarea(class="hidden", name="attr_talent_details", data-i18n-placeholder="talent-details")

