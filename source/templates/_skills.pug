// stying found in _equipmentAndSkills.scss
h2.headerLabel(data-i18n='skills') Skills
input(class="npcSkills", type="hidden", name="attr_current_character_type", value="1")
.skill
    .skillName &nbsp;
    .skillBonus 
        label(class="headerLabel", data-i18n='skill-bonus') Skill Bonus
    .emptyEquals &nbsp;
    .halfLevel 
        label(class="headerLabel", data-i18n='half-level') Half Level
    .emptyAddition 
    .abilityMod 
        label(class="headerLabel", data-i18n='ability-modifier-abbr') Ability Mod
    .emptyAddition 
    .trained 
        label(class="headerLabel", data-i18n='trained') Trained
    .emptyAddition 
    .skillFocus 
        label(class="headerLabel", data-i18n='skill-focus') Skill Focus
    .emptyAddition 
    .miscMod 
        label(class="headerLabel", data-i18n='miscellaneous-modifier-abbr') Misc Mod

each skill in skillList
    +skills(skill)
