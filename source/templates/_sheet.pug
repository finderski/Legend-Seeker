//- Necessary Mixins
include ./mixins/_mixin_attributes.pug 
include ./mixins/_mixin_corruption.pug
include ./mixins/_mixin_buildSaves.pug
include ./mixins/_mixin_skills.pug
include ./mixins/_mixin_npc_skills.pug
-
    const attributeList = [['STR', 'strength'], ['DEX', 'dexterity'], ['CON', 'constitution'],['INT', 'intelligence'],  ['WIS', 'wisdom'], ['CHA', 'charisma']];
    let sheetType = "character";
    const maxCorruption = 24;
    const saveList = [['FORT', 'fortitude', 'constitution'], ['REF', 'reflex', 'dexterity'], ['WILL', 'willpower', 'wisdom']];
    const fullAbilityList = ['strength', 'dexterity', 'constitution', 'intelligence', 'wisdom', 'charisma'];
    // list of skills with associated attribute ['skill name', 'attribute', 'training:na|some|trained', 'armorCheck:yes|no']
    const skillList = [['acrobatics','dexterity','some','yes'],['climb', 'strength','na','yes'],['craft', 'wisdom','na','no'],['deception', 'charisma','some','no'],  ['endurance', 'constitution','na','yes'],['gather-information','charisma','na','no'],['initiative','dexterity','na','yes'],['invoke-arcana','intelligence','trained','no'],['jump','strength','na','yes'],['lore-arcana','intelligence','na','no'],['lore-architecture','intelligence','na','no'],['lore-dungeoneering','intelligence','na','no'],['lore-geography','intelligence','na','no'],['lore-history','intelligence','na','no'],['lore-keepers','intelligence','na','no'],['lore-nature','intelligence','na','no'],['lore-nobility','intelligence','na','no'],['lore-planes','intelligence','na','no'],['lore-religion','intelligence','na','no'],['lore-streetwise','intelligence','na','no'],['notice','wisdom','na','yes'],['persuasion','charisma','na','no'],['ride','dexterity','na','yes'],['sense-motive','wisdom','na','no'],['stealth','dexterity','na','yes'],['survival','wisdom','na','no'],['swim','strength','na','yes'],['tinkering','intelligence','trained','yes'],['treat-wounds','wisdom','some','no'],['mana-tap','charisma','some','no']];

.maindiv
    //- Color Palette
        include _colors.pug
    // Hidden inputs for character sheet functionality
    input(type='hidden', name='attr_sheetversion', value='0.2.2')
    input(type='hidden', name='attr_shield_dr', value='0')
    // size_penalty is the stealth modifier based on the size of the character/monster.
    input(type='hidden', name='size_penalty', value='0')
    // REF Defense Score Modifier based on the size of the character/monster.
    input(type='hidden', name='monsterous_mod', value='0')
    // Damage Threshold Modifier based on the size of the character/monster.
    input(type='hidden', name='damage_threshold_mod', value='0')
    // Carry Capacity Multiplier based on the size of the character/monster.
    input(type='hidden', name='carry_capacity_multiplier', value='1')
    //- Tab Styling in _tabSetup.scss
    //- buttonbar styles in the _buttonbarStyles.scss
    input(type='hidden', class='selectedTab', name='attr_sheetTab', value="1")
    .sheetVersion 
        label(class="sheetVersionLabel", data-i18n='sheet-version') Sheet Version: 
        span(name='attr_sheetversion')
    .buttonbar 
        // Buttons to control the sheet display
        include _buttonbar.pug
    .frontPage
        h1(class='sheetTitle', data-i18n='character-score-sheet') Character Score Sheet
        .topSection
            .demographics 
                // Character Sheet (including NPC sheet)
                include _demographics.pug
            .logo 
                // Logo Section
                img(src='https://raw.githubusercontent.com/finderski/Legend-Seeker/main/images/lengend-seeker-logo.png', alt='Legend Seeker Logo')
        hr.sectionDivider
        .middleSection 
            .twoByOne 
                .firstCol
                    .threeBythree
                        .attributesSection
                            // Attributes Section
                            include _attributes.pug
                        .stamina 
                            // Staminia Section
                            include _stamina.pug
                        .hitPoints 
                            // Hit Point Section
                            include _hitPoints.pug
                        .corruption
                            // Corruption Section
                            include _corruption.pug
                        .defensiveSaves
                            //Defensive Saves Section
                            include _saves.pug
                .secondCol
                    h3.headerLabel(data-i18n="conditions") CONDITIONS
                    // Conditions Section
                    include _conditions.pug
                    include _languages.pug
        .damageReduction 
            // Damage Reduction Section
            .damageReduct
                input(type='hidden', name='attr_total_dr', value="0")
                label(class="subHeaderLabel", data-i18n='total-damage-reduction-abbr', data-i18n-title='total-damage-reduction') Total DR: 
                span(name="attr_total_dr")
            // Spell Reduction Section
            .spellReduct
                input(type='hidden', name='attr_total_sr', value="0")
                label(class="subHeaderLabel", data-i18n='total-spell-reduction-abbr', data-i18n-title='total-spell-reduction') Total SR: 
                span(name="attr_total_sr")
        hr.sectionDivider
        .combat
            input(class="hideSection", type="hidden", name="attr_mana-tap_hider", value="0")
            .spells 
                include _spells.pug
            .weapons 
                include _weapons.pug
    .npcView 
        h1.npcViewHeader 
            .logo 
                // Logo Section
                img(src='https://raw.githubusercontent.com/finderski/Legend-Seeker/main/images/lengend-seeker-logo.png', alt='Legend Seeker Logo')
            .npcMainFields
                label(class="legendaryMonster")
                    input(class='isLegendaryMonster', type='checkbox', value="1", name='attr_isLegendaryMonster')
                    span.legendaryMonster
                        != '&#x1F409;'
                input(class='npcHeader npcName text-field', type='text', name='attr_character_name', data-i18n-placeholder='name')
                .challengeLevel
                    span(class='npcHeader', data-i18n='challenge-level-abbr-caps', data-i18n-title='challenge-level') CL:
                    input(type="hidden", name="attr_challenge_level", value="0")
                    span(class="npcHeader", name="attr_challenge_level", value="0")
                .size 
                    select(class='ls-Dropdown', name='attr_monster_size')
                        option(value='') 
                        option(value='Fine', data-i18n='fine') Fine
                        option(value='Diminutive', data-i18n='diminutive') Diminutive
                        option(value='Tiny', data-i18n='tiny') Tiny
                        option(value='Small', data-i18n='small') Small
                        option(value='Medium', data-i18n='medium' selected) Medium
                        option(value='Large', data-i18n='large') Large
                        option(value='Huge', data-i18n='huge') Huge
                        option(value='Gargantuan', data-i18n='gargantuan') Gargantuan
                        option(value='Colossal', data-i18n='colossal') Colossal
                .type 
                    select(class='ls-Dropdown', name='attr_monster_type')
                        option(value='') 
                        option(value='Aberration', data-i18n='aberration') Aberration
                        option(value='Beast', data-i18n='beast') Beast
                        option(value='Construct', data-i18n='construct') Construct
                        option(value='Dragon', data-i18n='dragon') Dragon
                        option(value='Elemental', data-i18n='elemental') Elemental
                        option(value='Fey', data-i18n='fey') Fey
                        option(value='Giant', data-i18n='giant') Giant
                        option(value='Magical Beast', data-i18n='magical-beast') Magical Beast
                        option(value='Monstrous Humanoid', data-i18n='monstrous-humanoid') Monstrous Humanoid
                        option(value='Ooze', data-i18n='ooze') Ooze
                        option(value='Outsider', data-i18n='outsider') Outsider
                        option(value='Plant', data-i18n='plant') Plant
                        option(value='Undead', data-i18n='undead') Undead
                .alignment 
                    input(class='text-field', type='text', name='attr_alignment', value="", data-i18n-placeholder='alignment')
                    label(class='smallCaps', data-i18n='alignment') Alignment
        .topSection
            .demographics 
                // Character Sheet (including NPC sheet)
                include _demographicsNPC.pug
        .middleSection 
            .attributesEtc
                .attributesSection
                    // Attributes Section
                    -
                        sheetType = "npc";
                    include _attributes.pug
                .staminaHpCorruption
                    input(class='showNPCStamina',type='hidden', name='attr_show_npc_stamina', value="0")
                    .stamina 
                        // Staminia Section
                        include _stamina.pug
                    .hitPoints 
                        // Hit Point Section
                        include _hitPoints.pug
                    .corruption
                        // Corruption Section
                        include _corruption.pug
                .defensiveSaves
                    //Defensive Saves Section
                    include _saves.pug
            .conditionsCol
                // Conditions Section
                .conditions
                    h3.headerLabel(data-i18n="conditions") CONDITIONS
                    include _conditions.pug
                include _languages.pug
        .damageReduction 
            // Damage Reduction Section
            .damageReduct
                input(type='hidden', name='attr_total_dr', value="0")
                label(class="subHeaderLabel", data-i18n='total-damage-reduction-abbr', data-i18n-title='total-damage-reduction') Total DR: 
                span(name="attr_total_dr")
            // Spell Reduction Section
            .spellReduct
                input(type='hidden', name='attr_total_sr', value="0")
                label(class="subHeaderLabel", data-i18n='total-spell-reduction-abbr', data-i18n-title='total-spell-reduction') Total SR: 
                span(name="attr_total_sr")
        hr.sectionDivider
        include _skillsNPC.pug
        include _talentsEdgesStNPC.pug
        hr.sectionDivider
        .combat
            input(class="hideSection", type="hidden", name="attr_mana-tap_hider", value="0")
            .spells 
                include _spells.pug
            .weapons 
                include _weapons.pug
                
    .backPage
        .topContainer
            .equipment 
                include _equipment.pug
                hr.sectionDivider
                include _armor.pug
                include _classResources.pug
            .skills 
                include _skills.pug
        hr.sectionDivider
        .bottomSection
            // Talents Section
            .talents 
                include _talents.pug
            // Edges Section
            .edges 
                include _edges.pug
            //Special Traits Section
            .traits 
                include _specialTraits.pug
    .concise 
        h1.headerLabel(data-i18n="concise") Concise
        include _concise.pug
    .sheetSettings
        h1.headerLabel(data-i18n="settings") Settings
        include _settings.pug

