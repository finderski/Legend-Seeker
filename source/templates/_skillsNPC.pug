// Pick List on main page for NPCs/Monsters
.npcSkills 
    h3.headerLabel
        span(data-i18n='skills') Skills
        input(class="isEncumbered", type="hidden", name="attr_encumbrance_penalty", value="0")
        input(class="overCapacity", type="hidden", name="attr_over_carry_capacity", value="0")
        img(class="encumbranceIcon", src='https://raw.githubusercontent.com/finderski/Legend-Seeker/main/images/weight.png', data-i18n-alt="encumbered")
    .config 
        label.cog
            input(class='hiddenInput', type='checkbox', name='attr_npc_skill_config_toggle' value="1")
            span.configIcon y
    input(class='showConfig', type='hidden', name='attr_npc_skill_config_toggle' value="1")
    .configSkills 
        each skill in skillList
            +npcSkills(skill, 1)
    .skillButtons 
        each skill in skillList
            +npcSkills(skill, 2)
