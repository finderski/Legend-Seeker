// Styles are in _demographics.scss
.class 
    label(class='smallCaps', data-i18n='class') Class
    input(class='text-field', type='text', name='attr_class', value="", data-i18n-placeholder='class')
.level 
    label(class='smallCaps', data-i18n='level') Level
    input(class='text-field', type='text', name='attr_level', value="", data-i18n-placeholder='level')
    input(type='hidden', name='attr_half-level', value='0')
.level 
    label(class='smallCaps', data-i18n='minion-level') Minion Level
    input(class='text-field', type='text', name='attr_minion_level', value="", data-i18n-placeholder='minion-level')
.level 
    label(class='smallCaps', data-i18n='monster-level') Level
    input(class='text-field', type='text', name='attr_monster_level', value="", data-i18n-placeholder='monster-level')
.level.readOnly
    label(class="smallCaps", data-i18n='damage-threshold') Damage Threshold
    input(class="text-field", type='text', name='attr_stamina_damageThreshold', placeholder="0" readonly)
.speed 
    label(class='smallCaps', data-i18n='speed') Speed
    input(class='text-field', type='text', name='attr_speed', value="", placeholder='5')
